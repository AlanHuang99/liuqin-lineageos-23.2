diff --git a/peninit/liuqin_pen_init.c b/peninit/liuqin_pen_init.c
new file mode 100644
index 0000000000000000000000000000000000000000..c9ee088c5578240c80af6a6f5b48f393a215ec70
--- /dev/null
+++ b/peninit/liuqin_pen_init.c
@@ -0,0 +1,120 @@
+#define LOG_TAG "liuqin_pen_init"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdint.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+#include <log/log.h>
+
+#define TOUCH_DEVICE "/dev/xiaomi-touch"
+#define BOOT_MARKER "/dev/liuqin_pen/initialized"
+#define TOUCH_SET _IO('T', 0)
+#define TOUCH_MIN _IO('T', 3)
+#define TOUCH_MAX _IO('T', 4)
+#define PEN_MODE 20
+#define PEN_CONNECT 0x12
+
+/* The shipped xiaomi_touch module copies 256 integers in both directions, regardless of the _IO size. */
+static int touch_request(int fd, unsigned long command, int value, int32_t *result) {
+    int32_t request[256] = {0, PEN_MODE, value};
+    _Static_assert(sizeof(request) == 1024, "xiaomi_touch ioctl buffer size");
+
+    int rc = ioctl(fd, command, request);
+    if (rc < 0) {
+        ALOGE("Touch ioctl 0x%lx failed: %s", command, strerror(errno));
+        return -1;
+    }
+    if (rc != 0) {
+        ALOGE("Touch ioctl 0x%lx returned an incomplete copy: %d", command, rc);
+        return -1;
+    }
+    *result = request[0];
+    return 0;
+}
+
+/* Creating this file exclusively reserves the boot's single connect event, including after an ambiguous ioctl failure. */
+static int reserve_boot(int *marker_fd) {
+    int fd = open(BOOT_MARKER, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW, 0600);
+    if (fd >= 0) {
+        *marker_fd = fd;
+        return 1;
+    }
+    if (errno != EEXIST) {
+        ALOGE("Cannot reserve pen initialization: %s", strerror(errno));
+        return -1;
+    }
+
+    fd = open(BOOT_MARKER, O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+    if (fd < 0) {
+        ALOGE("Cannot read pen initialization state: %s", strerror(errno));
+        return -1;
+    }
+    char completed = 0;
+    ssize_t length = read(fd, &completed, sizeof(completed));
+    int close_result = close(fd);
+    if (length == 1 && completed == '1' && close_result == 0) {
+        ALOGI("Pen initialization already completed this boot");
+        return 0;
+    }
+    ALOGE("Pen initialization was already attempted this boot; refusing a second connect event");
+    return -1;
+}
+
+int main(void) {
+    int fd = open(TOUCH_DEVICE, O_RDWR | O_CLOEXEC);
+    if (fd < 0) {
+        ALOGE("Cannot open %s: %s", TOUCH_DEVICE, strerror(errno));
+        return 1;
+    }
+
+    int status = 1;
+    int marker_fd = -1;
+    int32_t minimum, maximum, result;
+    if (touch_request(fd, TOUCH_MIN, 0, &minimum) != 0 ||
+        touch_request(fd, TOUCH_MAX, 0, &maximum) != 0) {
+        goto out;
+    }
+    /* Check the shipped Novatek pen range and reject an unregistered callback. */
+    if (minimum != -1 || maximum != PEN_CONNECT) {
+        ALOGE("Unsupported pen mode bounds: %d..%d", minimum, maximum);
+        goto out;
+    }
+
+    int reserved = reserve_boot(&marker_fd);
+    if (reserved <= 0) {
+        status = reserved == 0 ? 0 : 1;
+        goto out;
+    }
+
+    /* 0x12 increments the pen connection count. Never retry this non-idempotent ioctl. */
+    if (touch_request(fd, TOUCH_SET, PEN_CONNECT, &result) != 0)
+        goto out;
+    if (result != 0) {
+        ALOGE("Novatek rejected the pen connect event: %d", result);
+        goto out;
+    }
+    ssize_t written = write(marker_fd, "1", 1);
+    if (written != 1) {
+        if (written < 0)
+            ALOGE("Pen connect event sent, but recording completion failed: %s", strerror(errno));
+        else
+            ALOGE("Pen connect event sent, but completion marker was not written");
+        goto out;
+    }
+    ALOGI("Pen connect event sent");
+    status = 0;
+
+out:
+    if (marker_fd >= 0 && close(marker_fd) != 0) {
+        ALOGE("Closing pen initialization state failed: %s", strerror(errno));
+        status = 1;
+    }
+    if (close(fd) != 0) {
+        ALOGE("Closing touch device failed: %s", strerror(errno));
+        status = 1;
+    }
+    return status;
+}
